# Sistema de Agenda Clinica — Configuracion
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env

# -----------------------------------------------------------------------
# ANTHROPIC (Claude) — requerido para el agente conversacional
# Obtener en: https://console.anthropic.com/
# -----------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------
# WHATSAPP BUSINESS — Meta Cloud API
# Obtener en: Meta Business Manager → WhatsApp → API Setup
#
# WHATSAPP_ACCESS_TOKEN:    token de acceso permanente
# WHATSAPP_PHONE_NUMBER_ID: ID numerico del numero (no el numero en si)
#                           lo encuentras en WhatsApp → API Setup → Phone Number ID
# WHATSAPP_WEBHOOK_VERIFY_TOKEN: string secreto que tu eliges
#                                se configura en Meta al registrar el webhook
# -----------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=un-token-secreto-que-tu-eliges

# Activar envio real de mensajes
# false = modo simulacion (desarrollo/pruebas)
# true  = envia mensajes reales a los pacientes (produccion)
WHATSAPP_ENABLED=false

# -----------------------------------------------------------------------
# APLICACION
# -----------------------------------------------------------------------
APP_ENV=development
# development | production

CLINIC_NAME=Centro Clinico
TIMEZONE=America/Santiago

# Ruta de la base de datos SQLite
DATABASE_PATH=data/clinica.db

# -----------------------------------------------------------------------
# SCHEDULER DE CONFIRMACIONES PROACTIVAS
# -----------------------------------------------------------------------
SCHEDULER_ENABLED=false
# true activa el scheduler automatico al iniciar el servidor

# Hora (24h) a la que se envian los recordatorios del dia siguiente
SCHEDULER_HORA_CONFIRMACION=10

# Hora (24h) del segundo recordatorio si el paciente no respondio
SCHEDULER_HORA_RECORDATORIO=14

# -----------------------------------------------------------------------
# CONECTOR MYDOC (configurar cuando este disponible)
# -----------------------------------------------------------------------
CONECTOR_MODO=local
# local  = base de datos SQLite de prueba (default)
# mydoc  = API REST de Mydoc
# export = importacion de Excel diario de Mydoc

# Solo necesario cuando CONECTOR_MODO=mydoc:
# MYDOC_API_URL=https://api.mydoc.cl/v1
# MYDOC_API_TOKEN=
# MYDOC_CLINIC_ID=
